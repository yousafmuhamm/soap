# NVIDIA NIM (OpenAI-compatible) - powers the AI concierge chat widget.
# Get a key at https://build.nvidia.com  (server-side only; never exposed to the browser).
NVIDIA_API_KEY=

# Optional model overrides (sensible defaults are used if unset):
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Where contact-form and concierge leads are delivered.
LEAD_RECIPIENT=yeongwoninfinity2026@gmail.com

# Email delivery via EmailJS (https://emailjs.com). The account is the agency's
# (parallaxleads@gmail.com); the connected Gmail service sends each lead to
# LEAD_RECIPIENT above.
#
# Setup:
#   1. Email Services > add Gmail, connect parallaxleads@gmail.com -> service id.
#   2. Email Templates > new template -> template id. Set:
#        To email   {{to_email}}
#        Reply to   {{reply_to}}
#        From name  {{from_name}}
#        Subject    {{subject}}
#        Content    {{message}}
#   3. Account > General -> public key; Account > Security -> private key, and
#      enable "Allow EmailJS API for non-browser applications" (these calls come
#      from the Next.js server, not the browser).
#
# Without all four values, leads are not delivered and the forms show a
# recoverable error.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
