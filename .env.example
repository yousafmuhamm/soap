# NVIDIA NIM (OpenAI-compatible) - powers the AI concierge chat widget.
# Get a key at https://build.nvidia.com  (server-side only; never exposed to the browser).
NVIDIA_API_KEY=

# Optional model overrides (sensible defaults are used if unset):
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Where contact-form and concierge leads are delivered.
LEAD_RECIPIENT=yeongwoninfinity2026@gmail.com

# Email delivery via Resend (https://resend.com). Without RESEND_API_KEY, leads
# are logged to the server and the forms still succeed. Once a domain is
# verified in Resend, set MAIL_FROM to an address on that domain.
# RESEND_API_KEY=
# MAIL_FROM=Yeong Won <hello@yourdomain.com>
